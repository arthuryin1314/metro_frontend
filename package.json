    "pinia": "^4.0.2",
    "viewerjs": "^1.11.8",
    "vue": "^3.5.40",
    "vue-data-ui": "^3.22.14",
    "vue-router": "^5.2.0",
    "vue3-seamless-scroll": "^3.0.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/cesium-china__cesium-map": "^1.0.0",
